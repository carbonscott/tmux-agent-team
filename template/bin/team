#!/bin/sh
''':'
exec "$(dirname "$0")/../tools/py/bin/python" "$0" "$@"
'''
# The three lines above start this file with the work directory's own Python (set up by uv in
# setup.sh): to a shell they are a no-op and an exec, to Python a string.
"""team: the only door out of an agent sandbox.

Requests are dropped in this workspace's spool (.gw/req) and relayed by the
gateway, which stamps them with this workspace's agent identity.
"""
import json
import os
import sys
import time
import uuid

USAGE = """usage:
  team whoami                 your identity as the gateway sees it
  team status                 time left, what has landed on main, pause state
  team sql "<SQL>"            run SQL on the team board; me() is your identity
  team sql -f FILE | team sql -     SQL from a file / stdin
  team push                   publish your committed HEAD to branch agent/<you>
  team precheck [--quick]     ask the merge job what it would say about your HEAD now; lands nothing
                              (--quick: only whether it merges cleanly and touches allowed paths)
  team mr "<title>"           push, then ask the merge job to land it on main
  team wait <seconds>         wait (max 110), then print status; ends at once if the team is
                              paused or the run is over
Exit status of team status and team wait: 0 the run goes on, 3 the team is paused, 4 the run
is over for you (complete, stalled, out of time, or you were removed). On 3 or 4 the reason is
printed on stderr too, so a filter on stdout cannot hide it.
  team msg <agent|all> "<text>"   send a message to one agent, or to all; text - reads stdin
  team inbox [--all]          print your unread messages and mark them read (--all: every
                              message to or from you). `team status` shows how many are unread.

Messages are not private: they are stored on the board (table `messages`), where every
agent and the boss can read them. Orders, claims and plans still belong in the board's tables.
"""


def ws_root():
    d = os.path.realpath(os.getcwd())
    while True:
        if os.path.isdir(os.path.join(d, ".gw", "req")):
            return d
        p = os.path.dirname(d)
        if p == d:
            sys.exit("team: not inside an agent workspace (no .gw/ found)")
        d = p


def call(op, timeout, **kw):
    root = ws_root()
    rid = uuid.uuid4().hex
    req = os.path.join(root, ".gw", "req", rid + ".json")
    resp = os.path.join(root, ".gw", "resp", rid + ".json")
    with open(req + ".tmp", "w") as f:
        json.dump(dict(id=rid, op=op, **kw), f)
    os.rename(req + ".tmp", req)
    t0 = time.time()
    while time.time() - t0 < timeout:
        if os.path.exists(resp):
            with open(resp) as f:
                r = json.load(f)
            os.unlink(resp)
            out, code = r.get("out", ""), r.get("code", 0)
            if out:
                print(out)
            if op in ("status", "wait") and code in (3, 4):
                ends = ("RUN COMPLETE", "STALLED", "TIME IS UP", "TEAM PAUSED", "You have been removed")
                why = [l for l in out.splitlines() if l.startswith(ends)] or out.splitlines()[-1:]
                print("team: %s (exit %d: %s)" % (" ".join(why), code, "the team is paused" if code == 3
                                                    else "the run is over for you"), file=sys.stderr)
            return code
        time.sleep(0.05)
    print("team: gateway did not answer within %ds" % timeout, file=sys.stderr)
    return 75


def main(argv):
    if not argv or argv[0] in ("help", "-h", "--help"):
        print(USAGE)
        return 0
    cmd, args = argv[0], argv[1:]
    if cmd == "whoami":
        return call("whoami", 20)
    if cmd == "status":
        return call("status", 20)
    if cmd == "sql":
        if not args:
            print(USAGE)
            return 2
        if args[0] == "-":
            q = sys.stdin.read()
        elif args[0] == "-f":
            q = open(args[1]).read()
        else:
            q = " ".join(args)
        return call("sql", 40, sql=q)
    if cmd == "push":
        return call("push", 60)
    if cmd == "precheck":
        return call("precheck", 400, quick="--quick" in args)
    if cmd == "mr":
        return call("mr", 400, title=" ".join(args) or "(no title)")
    if cmd == "msg":
        if len(args) < 2:
            print('usage: team msg <agent|all> "<text>"', file=sys.stderr)
            return 2
        body = sys.stdin.read() if args[1:] == ["-"] else " ".join(args[1:])
        return call("msg", 20, to=args[0], body=body)
    if cmd == "inbox":
        if args not in ([], ["--all"]):
            print("usage: team inbox [--all]", file=sys.stderr)
            return 2
        return call("inbox", 20, all=bool(args))
    if cmd == "wait":
        n = max(1, min(110, int(float(args[0])) if args else 30))
        return call("wait", n + 30, seconds=n)
    print(USAGE)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
